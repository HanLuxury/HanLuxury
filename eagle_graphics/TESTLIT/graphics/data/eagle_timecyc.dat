//////////// EAGLE Graphics - data/eagle_timecyc.dat
// Tampilan per waktu (TimeCycleFX). Bukan timecyc.dat GTA: arah matahari
// tetap diambil dari GTA (CTimeCycle::m_VectorToSun) supaya bayangan cocok
// dengan matahari yang terlihat. Baris yang hilang = nilai bawaan.
//
// RAMPS: jam pusat transisi (masing-masing 1 jam, smoothstep)
//        malam->pagi  pagi->siang  siang->sore  sore->malam
RAMPS    5.0  7.0  16.0  19.0
//
// Kolom (17 angka):
//  SunR SunG SunB      warna matahari (sun boost)
//  SunInt              intensitas matahari
//  ShdStr              kekuatan bayangan (dikali [Shadow] fStrength)
//  TintR TintG TintB   warna area bayangan penuh (cahaya langit)
//  Boost               tambahan cahaya matahari (dikali [Shadow] fSunBoost)
//  Expo Sat Contr Bloom FogR FogG FogB FogDens   [BELUM AKTIF - PHASE 6 post-process]
//
//Period  SunR SunG SunB  SunInt ShdStr  TintR TintG TintB  Boost  Expo  Sat   Contr Bloom  FogR FogG FogB  FogDens
SUNRISE   1.00 0.74 0.50  0.85   0.80    0.55  0.53  0.64   1.15   1.06  1.04  1.03  1.15   0.96 0.78 0.66  1.10
DAY       1.00 0.96 0.90  1.00   1.00    0.46  0.50  0.60   1.00   1.00  1.04  1.03  0.80   0.72 0.80 0.90  0.80
SUNSET    1.00 0.62 0.34  0.92   0.88    0.50  0.45  0.60   1.35   1.04  1.06  1.05  1.30   0.98 0.66 0.42  1.20
NIGHT     0.55 0.62 0.85  0.00   0.00    0.70  0.72  0.82   0.00   1.18  0.95  1.02  1.20   0.22 0.28 0.40  0.90
//
// Hujan/awan/kabut diterapkan di atas baris-baris ini oleh engine
// (bayangan melemah, warna lebih dingin) - lihat TimeCycleFX.cpp.
