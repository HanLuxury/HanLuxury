+        _ini_entry_create(section, key, value);
+        return;
+    }
+    char* copy = (char*)malloc((strlen(value)+1)*sizeof(char));
+    if (copy == NULL) return;
+    strcpy(copy, value);
+    free(entry->value);
+    entry->value = copy;
+}
