+    std::memcpy(w, &id, 4);
+    std::memcpy(w + 4, &fn, sizeof(fn));
+    std::memcpy(w + 4 + sizeof(fn), &arg, sizeof(arg));
+    q->mainWorkPointer = w + kPayload;
